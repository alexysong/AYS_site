@article{Song_APL2014_FeZnSe,
abstract = {We report the realization of light emission from a Fe2+ doped ZnSe polycrystal with efficient pumping from a quantum cascade (QC) laser. The QC laser photon energy is near the absorption edge of the Fe2+:ZnSe with less than ∼60 meV Stokes' shift. The Fe2+:ZnSe polycrystal shows an absorption band of ∼2.2 - 5 $\mu$m in the mid-infrared (mid-IR) at room temperature, which narrows down to ∼2.4-4.2 $\mu$m at 80 K. Clear photoluminescence (PL) from 4.5 $\mu$m to 6 $\mu$m are observed throughout the temperature range of 300 K to 80 K. At room temperature, the luminescence lifetime is about 0.38 ± 0.1 $\mu$s which increases up to 101 ± 2 $\mu$s at 118 K. This system transfers energy stored in the upper state of a QC laser with ∼ps lifetime to the Fe2+:ZnSe with 105 to 108 times longer lifetime, at the cost of minute photon energy losses.},
author = {Song, Yu and Sonntag, Jens and Mirov, Sergey B. and Gmachl, Claire F. and Khurgin, Jacob B.},
doi = {10.1063/1.4897546},
issn = {0003-6951},
journal = {Applied Physics Letters},
month = {10},
number = {14},
pages = {141108},
title = {{Mid-infrared light emission from a Fe 2+ :ZnSe polycrystal using quantum cascade laser pumping}},
url = {http://aip.scitation.org/doi/10.1063/1.4897546},
volume = {105},
year = {2014}
}
