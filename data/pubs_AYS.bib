pages = {1019--1023},
pmid = {27701110},
title = {{Radiative human body cooling by nanoporous polyethylene textile}},
url = {https://www.sciencemag.org/lookup/doi/10.1126/science.aaf5471 http://www.sciencemag.org/lookup/doi/10.1126/science.aaf5471 https://www.science.org/doi/10.1126/science.aaf5471},
